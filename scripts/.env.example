# Copy this file to .env and customise. All keys are optional.

# Where to write the results JSON store. Absolute or relative; relative paths
# resolve against the current working directory. The CLI flag --output overrides
# this. Default: ./results.json (in whatever directory you run main.py from).
#RESULTS_JSON=./results.json

# Destination for the derived CSV view, written when main.py is run with
# --export-csv (or by export_csv.py). Point this inside your Google Drive sync
# folder so the CSV reaches Sheets without OAuth. The CLI flag --csv-output
# overrides this. When unset, --export-csv writes next to the JSON (.csv suffix).
#RESULTS_CSV=./results.csv
