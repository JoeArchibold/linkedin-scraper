# DEPRECATED. These settings still work, but are deprecated in favour of the
# "output_json" / "output_csv" keys in sheet_layout.json — declare your paths
# there instead. A new setup should not need a .env file at all.
#
# Precedence (highest first): CLI flag > sheet_layout.json > this .env > default.
# Note: paths here resolve against the CURRENT WORKING DIRECTORY, whereas paths
# in sheet_layout.json resolve against the layout file's directory.
#
# Copy this file to .env only if you still want the env-based fallback. All keys
# are optional.

# Where to write the results JSON store. Absolute or relative; relative paths
# resolve against the current working directory. The CLI flag --output and the
# layout's "output_json" both override this. Default: ./results.json.
#RESULTS_JSON=./results.json

# Destination for the derived CSV view, written when main.py is run with
# --export-csv (or by export_csv.py). Point this inside your Google Drive sync
# folder so the CSV reaches Sheets without OAuth. The CLI flag --csv-output and
# the layout's "output_csv" both override this. When unset, --export-csv writes
# next to the JSON (.csv suffix).
#RESULTS_CSV=./results.csv
